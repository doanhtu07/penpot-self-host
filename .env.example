# Copy to `.env` and fill in:
#
#   pnpm copy-env            # or manually: cp .env.example .env
#   set -a; source .env; set +a   # required before starting OpenCode / Claude Code
#
# `.env` is gitignored; this example file is not.
#
# See docs/connect-mcp.md for the full MCP walkthrough.

# ---------------------------------------------------------------------------
# Penpot MCP client
# ---------------------------------------------------------------------------
# Personal MCP key from Penpot: Your account -> Integrations -> MCP Server.
# Shown only once. One key per user; regenerating revokes the previous key.
PENPOT_MCP_TOKEN=

# Convenience copy for shell commands (`curl`, `claude mcp add --url ...`).
# Derived from PENPOT_MCP_TOKEN above.
PENPOT_MCP_URL=http://localhost:9001/mcp/stream?userToken=

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# Interpolated by docker-compose.yaml as ${PENPOT_VERSION:-2.18}. Pins the
# backend / frontend / admin-console / exporter / mcp image tags together;
# leaving it unset means 2.18.
PENPOT_VERSION=2.18

# NOTE: other PENPOT_* settings (flags, public URI, secret key, SMTP, ...) are
# hardcoded in docker-compose.yaml today, so exporting them here does nothing.
# Edit the `x-flags` / `x-uri` / `x-secret-key` anchors there instead.
