{
  "name": "root",
  "version": "1.0.0",
  "keywords": [],
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "prepare": "husky",
    "start": "docker compose -p penpot -f docker-compose.yaml up -d",
    "copy-env": "test -f .env && echo '.env already exists, not overwriting' || { cp .env.example .env && echo 'Created .env from .env.example - add your PENPOT_MCP_TOKEN'; }",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
